# Database Configuration
DB_NAME=bookverse_db
DB_USERNAME=bookverse_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://localhost:4200,https://bookverse.com

# SSL Configuration (Production)
SSL_ENABLED=false
SSL_KEYSTORE=
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12

# Rate Limiting
RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=200

# Frontend Environment Variables
API_URL=https://api.bookverse.com
AUTH_URL=https://auth.bookverse.com/api
CART_URL=https://cart.bookverse.com/api
ADMIN_URL=https://admin.bookverse.com/api

# Test Environment Variables
TEST_USERNAME=testuser
TEST_EMAIL=test@example.com
TEST_PASSWORD=TestPassword123!
TEST_ADMIN_USERNAME=testadmin
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPassword123!